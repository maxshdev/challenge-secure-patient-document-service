# ── Database (PostgreSQL) ──────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=root
DB_NAME=patient_documents

# ── Server ─────────────────────────────────────────
PORT=4000

# ── AWS S3 ─────────────────────────────────────────
S3_MOCK=true
